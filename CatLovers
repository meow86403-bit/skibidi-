local snowflakes = {}
local snowflakeCoroutine = nil
local darkenEnabled = true
local snowEnabled = true

local function createSnowflakes()
    for _, data in ipairs(snowflakes) do
        if data.flake then data.flake:Destroy() end
    end
    snowflakes = {}
    for i = 1, 50 do
        local snowflake = Instance.new("Frame")
        snowflake.Size = UDim2.new(0, math.random(2, 5), 0, math.random(2, 5))
        snowflake.Position = UDim2.new(math.random(), 0, math.random(), 0)
        snowflake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        snowflake.BackgroundTransparency = math.random(20, 60) / 100
        snowflake.BorderSizePixel = 0
        snowflake.ZIndex = 2
        snowflake.Parent = snowflakeContainer
        Instance.new("UICorner", snowflake).CornerRadius = UDim.new(1, 0)
        table.insert(snowflakes, {
            flake = snowflake,
            speed = math.random(20, 60) / 10,
            xOffset = math.random(),
            wobble = math.random() * math.pi * 2,
            wobbleSpeed = math.random(10, 30) / 10
        })
    end
end

local function startSnowflakes()
    if snowflakeCoroutine then return end
    snowflakeCoroutine = coroutine.create(function()
        while snowEnabled and snowflakeContainer.Parent do
            local dt = task.wait()
            for _, data in ipairs(snowflakes) do
                local flake = data.flake
                if flake and flake.Parent then
                    local newY = flake.Position.Y.Scale + (data.speed * dt / 100)
                    if newY > 1 then newY = newY - 1 end
                    data.wobble = data.wobble + data.wobbleSpeed * dt
                    local newX = data.xOffset + math.sin(data.wobble) * 0.02
                    flake.Position = UDim2.new(newX, 0, newY, 0)
                end
            end
        end
    end)
    coroutine.resume(snowflakeCoroutine)
end

local function stopSnowflakes()
    snowflakeCoroutine = nil
    for _, data in ipairs(snowflakes) do
        if data.flake then data.flake:Destroy() end
    end
    snowflakes = {}
end

