local function createFOVCircle()
    if fovCircle then fovCircle:Remove() end
    fovCircle = Drawing.new("Circle"); fovCircle.Visible = drawFovEnabled and fovVisible
    fovCircle.Color = Color3.fromRGB(255,255,255); fovCircle.Thickness = 1.5; fovCircle.NumSides = 64
    fovCircle.Radius = fovRadius; fovCircle.Filled = false; fovCircle.Transparency = 1; fovCircle.ZIndex = 10
end

local function updateFOVPos()
    if not fovCircle or not drawFovEnabled then return end
    local mp = UserInputService:GetMouseLocation()
    fovCircle.Position = Vector2.new(mp.X, mp.Y); fovCircle.Radius = fovRadius
end

local function toggleDrawFOV(state)
    drawFovEnabled = state
    if not fovCircle then createFOVCircle() else fovCircle.Visible = state and fovVisible end
    if state then
        if fovDrawConnection then fovDrawConnection:Disconnect() end
        fovDrawConnection = RunService.RenderStepped:Connect(updateFOVPos)
    else
        if fovDrawConnection then fovDrawConnection:Disconnect(); fovDrawConnection = nil end
        stopFOVAimbot()
    end
end

local function toggleFOVVisible(state)
    fovVisible = state
    if fovCircle then fovCircle.Visible = drawFovEnabled and state end
end

local function aimAtPosition(tp)
    local c = player.Character; if not c then return end
    local ld = (tp - camera.CFrame.Position).Unit
    local tcf = CFrame.lookAt(camera.CFrame.Position, camera.CFrame.Position + ld)
    if fovAimbotSmoothness <= 1 then camera.CFrame = tcf
    else camera.CFrame = camera.CFrame:Lerp(tcf, 1/fovAimbotSmoothness) end
end

local function stopFOVAimbot()
    fovAimLockActive = false
    fovLockedTarget = nil
    if fovAimbotConnection then
        fovAimbotConnection:Disconnect()
        fovAimbotConnection = nil
    end
end

local function startFOVAimbot()
    if not rightMouseDown or not drawFovEnabled then return end
    if fovAimLockActive then return end
    
    stopFOVAimbot()
    
    local mp = UserInputService:GetMouseLocation()
    local initialTarget = getClosestPlayerInFOV(mp, fovRadius)
    
    if not initialTarget then return end
    
    fovLockedTarget = initialTarget
    fovAimLockActive = true
    
    fovAimbotConnection = RunService.RenderStepped:Connect(function()
        if not rightMouseDown or not drawFovEnabled then
            stopFOVAimbot()
            return
        end
        
        if not fovLockedTarget or not fovLockedTarget.Character or isWhitelisted(fovLockedTarget) then
            stopFOVAimbot()
            return
        end
        
        if aimTeamCheckEnabled and fovLockedTarget.Team == player.Team then
            stopFOVAimbot()
            return
        end
        
        local tc = fovLockedTarget.Character
        local th = tc:FindFirstChild("Humanoid")
        local ap = getAimPosition(tc)
        
        if not ap or not th or th.Health <= 0 then
            stopFOVAimbot()
            return
        end
        
        local mp2 = UserInputService:GetMouseLocation()
        local sp, on = worldToScreen(ap)
        if not on or (sp - mp2).Magnitude > fovRadius then
            stopFOVAimbot()
            return
        end
        
        aimAtPosition(ap)
    end)
end

UserInputService.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton2 and drawFovEnabled then
        rightMouseDown = true
        stopFOVAimbot()
        startFOVAimbot()
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton2 then
        rightMouseDown = false
        stopFOVAimbot()
    end
end)

