-- === ESP (with team check) ===
local function createESPBox(tp)
    if isWhitelisted(tp) then return end
    if teamCheckEnabled and tp.Team == player.Team then return end
    if espObjects[tp] then espObjects[tp]:Destroy() end
    local hl = Instance.new("Highlight")
    hl.FillColor = COLORS.ESP; hl.FillTransparency = 1; hl.OutlineColor = COLORS.ESP
    hl.OutlineTransparency = 0; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = tp.Character; hl.Parent = tp.Character
    espObjects[tp] = hl
    if espConnections[tp] then espConnections[tp]:Disconnect() end
    espConnections[tp] = tp.CharacterAdded:Connect(function(nc)
        if espEnabled and espObjects[tp] and not isWhitelisted(tp) then
            if teamCheckEnabled and tp.Team == player.Team then
                espObjects[tp]:Destroy()
                espObjects[tp] = nil
                return
            end
            espObjects[tp].Adornee = nc; espObjects[tp].Parent = nc
        end
    end)
end

local function toggleESP(state)
    espEnabled = state
    if state then
        for _,p in ipairs(Players:GetPlayers()) do if p ~= player and p.Character and not isWhitelisted(p) then
            if teamCheckEnabled and p.Team == player.Team then continue end
            createESPBox(p)
        end end
        if espUpdateConnection then espUpdateConnection:Disconnect() end
        espUpdateConnection = RunService.Heartbeat:Connect(function()
            if not espEnabled then return end
            for _,p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character then
                    if isWhitelisted(p) then
                        if espObjects[p] then espObjects[p]:Destroy(); espObjects[p] = nil end
                        if espConnections[p] then espConnections[p]:Disconnect(); espConnections[p] = nil end
                    elseif teamCheckEnabled and p.Team == player.Team then
                        if espObjects[p] then espObjects[p]:Destroy(); espObjects[p] = nil end
                        if espConnections[p] then espConnections[p]:Disconnect(); espConnections[p] = nil end
                    elseif not espObjects[p] then
                        createESPBox(p)
                    end
                end
            end
        end)
        if espPlayerAddedConnection then espPlayerAddedConnection:Disconnect() end
        espPlayerAddedConnection = Players.PlayerAdded:Connect(function(np)
            if espEnabled and np ~= player then
                np.CharacterAdded:Connect(function() if espEnabled and not isWhitelisted(np) then
                    if teamCheckEnabled and np.Team == player.Team then return end
                    createESPBox(np)
                end end)
                if np.Character and not isWhitelisted(np) then
                    if teamCheckEnabled and np.Team == player.Team then return end
                    createESPBox(np)
                end
            end
        end)
    else
        for p,hl in pairs(espObjects) do if hl then hl:Destroy() end end
        espObjects = {}
        for _,c in pairs(espConnections) do c:Disconnect() end
        espConnections = {}
        if espUpdateConnection then espUpdateConnection:Disconnect(); espUpdateConnection = nil end
        if espPlayerAddedConnection then espPlayerAddedConnection:Disconnect(); espPlayerAddedConnection = nil end
    end
end

-- === BOX ESP ===
local function createBoxESP(tp)
    if isWhitelisted(tp) then return end
    if teamCheckEnabled and tp.Team == player.Team then return end
    if boxEspObjects[tp] then for _,d in ipairs(boxEspObjects[tp]) do pcall(function() d:Remove() end) end end
    local lines = {}
    for _=1,12 do
        local l = Drawing.new("Line"); l.Visible = false; l.Color = Color3.fromRGB(255,255,255)
        l.Thickness = 1.5; l.Transparency = 1; l.ZIndex = 10; table.insert(lines, l)
    end
    boxEspObjects[tp] = lines
    if boxEspConnections[tp] then boxEspConnections[tp]:Disconnect() end
    boxEspConnections[tp] = tp.CharacterAdded:Connect(function() task.wait(0.1); if boxEspEnabled and not isWhitelisted(tp) then
        if teamCheckEnabled and tp.Team == player.Team then return end
        createBoxESP(tp)
    end end)
end

local function updateBoxESP()
    for plr,lines in pairs(boxEspObjects) do
        if isWhitelisted(plr) or (teamCheckEnabled and plr.Team == player.Team) then
            for _,l in ipairs(lines) do pcall(function() l:Remove() end) end
            boxEspObjects[plr] = nil
            if boxEspConnections[plr] then boxEspConnections[plr]:Disconnect(); boxEspConnections[plr] = nil end
            continue
        end
        local c = plr.Character
        if not c then for _,l in ipairs(lines) do l.Visible = false end continue end
        local head = c:FindFirstChild("Head"); local root = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChild("Humanoid")
        if not head or not root or not hum or hum.Health <= 0 then for _,l in ipairs(lines) do l.Visible = false end continue end
        local hp = head.Position + Vector3.new(0,0.5,0); local fp = root.Position - Vector3.new(0,3,0)
        local cr = camera.CFrame.RightVector; local cf = Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z).Unit
        local bw = 2; local bd = 1
        local ro = cr * bw; local fo = cf * bd
        local corners = {worldToScreen(fp+ro+fo), worldToScreen(fp+ro-fo), worldToScreen(fp-ro-fo), worldToScreen(fp-ro+fo),
                        worldToScreen(hp+ro+fo), worldToScreen(hp+ro-fo), worldToScreen(hp-ro-fo), worldToScreen(hp-ro+fo)}
        local all = true; for _,c in ipairs(corners) do if not c then all = false break end end
        if all then
            local edges = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
            for i,e in ipairs(edges) do lines[i].From = corners[e[1]]; lines[i].To = corners[e[2]]; lines[i].Visible = boxEspEnabled end
        else for _,l in ipairs(lines) do l.Visible = false end end
    end
end

local function toggleBoxESP(state)
    boxEspEnabled = state
    if state then
        for _,p in ipairs(Players:GetPlayers()) do if p ~= player and p.Character and not isWhitelisted(p) then
            if teamCheckEnabled and p.Team == player.Team then continue end
            createBoxESP(p)
        end end
        if boxEspUpdateConnection then boxEspUpdateConnection:Disconnect() end
        boxEspUpdateConnection = RunService.RenderStepped:Connect(updateBoxESP)
    else
        for _,lines in pairs(boxEspObjects) do for _,l in ipairs(lines) do pcall(function() l:Remove() end) end end
        boxEspObjects = {}; for _,c in pairs(boxEspConnections) do c:Disconnect() end; boxEspConnections = {}
        if boxEspUpdateConnection then boxEspUpdateConnection:Disconnect(); boxEspUpdateConnection = nil end
    end
end

