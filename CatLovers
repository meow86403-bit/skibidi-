-- Insert key toggle minimize
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        isMinimized = not isMinimized
        local targetHeight = isMinimized and MINIMIZED_HEIGHT or FULL_HEIGHT
        local currentPos = mainFrame.Position
        local tween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, WINDOW_WIDTH, 0, targetHeight),
            Position = UDim2.new(currentPos.X.Scale, currentPos.X.Offset, currentPos.Y.Scale, currentPos.Y.Offset)
        })
        tween:Play()
        minBtn.Text = isMinimized and "□" or "—"
    end
end)

