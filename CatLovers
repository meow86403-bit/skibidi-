        task.wait(0.1)
        if boxEspEnabled then
            createBoxEspForPlayer(targetPlayer)
        end
    end)
end

local function updateBoxEspPositions()
    for plr, lines in pairs(boxEspObjects) do
        local char = plr.Character
        if not char then
            for _, line in ipairs(lines) do
                line.Visible = false
            end
            continue
        end
        
        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChild("Humanoid")
        
        if not head or not root or not humanoid or humanoid.Health <= 0 then
            for _, line in ipairs(lines) do
                line.Visible = false
            end
            continue
        end
        
        local headPos = head.Position + Vector3.new(0, 0.5, 0)
        local footPos = root.Position - Vector3.new(0, 3, 0)
        local boxWidth = 2
        local boxDepth = 1
        
        local camRight = camera.CFrame.RightVector
        local camForward = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
        
        local rightOffset = camRight * boxWidth
        local forwardOffset = camForward * boxDepth
        
        local b1 = footPos + rightOffset + forwardOffset
        local b2 = footPos + rightOffset - forwardOffset
        local b3 = footPos - rightOffset - forwardOffset
        local b4 = footPos - rightOffset + forwardOffset
        
        local t1 = headPos + rightOffset + forwardOffset
        local t2 = headPos + rightOffset - forwardOffset
        local t3 = headPos - rightOffset - forwardOffset
        local t4 = headPos - rightOffset + forwardOffset
        
        local corners = {}
        local allOnScreen = true
        
        local positions = {b1, b2, b3, b4, t1, t2, t3, t4}
        for _, pos in ipairs(positions) do
            local screenPos, onScreen = worldToScreen(pos)
            if not onScreen then allOnScreen = false end
            table.insert(corners, screenPos)
        end
        
        if allOnScreen then
            lines[1].From = corners[1]; lines[1].To = corners[2]
            lines[2].From = corners[2]; lines[2].To = corners[3]
            lines[3].From = corners[3]; lines[3].To = corners[4]
            lines[4].From = corners[4]; lines[4].To = corners[1]
            
            lines[5].From = corners[5]; lines[5].To = corners[6]
            lines[6].From = corners[6]; lines[6].To = corners[7]
            lines[7].From = corners[7]; lines[7].To = corners[8]
            lines[8].From = corners[8]; lines[8].To = corners[5]
            
            lines[9].From = corners[1]; lines[9].To = corners[5]
            lines[10].From = corners[2]; lines[10].To = corners[6]
            lines[11].From = corners[3]; lines[11].To = corners[7]
            lines[12].From = corners[4]; lines[12].To = corners[8]
            
            for _, line in ipairs(lines) do
                line.Visible = boxEspEnabled
            end
        else
            for _, line in ipairs(lines) do
                line.Visible = false
            end
        end
    end
end

