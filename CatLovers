-- === UTILITY FUNCTIONS ===
local function worldToScreen(worldPos)
    local screenPos, onScreen = camera:WorldToViewportPoint(worldPos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

local function getClosestPlayerInFOV(mousePos, fovRadius)
    local closestPlayer = nil
    local closestDist = fovRadius
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local char = plr.Character
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local aimPart = nil
                if fovTarget == "Torso" then
                    aimPart = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                end
                if not aimPart then
                    aimPart = char:FindFirstChild("Head")
                end
                if aimPart then
                    local screenPos, onScreen = worldToScreen(aimPart.Position)
                    if onScreen then
                        local dist = (screenPos - mousePos).Magnitude
                        if dist <= fovRadius and dist < closestDist then
                            closestDist = dist
                            closestPlayer = plr
                        end
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

local function getAimPosition(targetChar)
    if fovTarget == "Torso" then
        local torso = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")
        if torso then
            return torso.Position
        end
    end
    local head = targetChar:FindFirstChild("Head")
    if head then
        return head.Position
    end
    return nil
end

