-- === KEYBINDS (including speed keybind and Enter support) ===
UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    -- Insert key toggles GUI
    if i.KeyCode == Enum.KeyCode.Insert then
        guiHidden = not guiHidden
        mainFrame.Visible = not guiHidden
        
        if guiHidden then
            backgroundOverlay.Visible = false
            snowflakeContainer.Visible = false
            stopSnowflakes()
        else
            backgroundOverlay.Visible = darkenEnabled
            if snowEnabled then
                createSnowflakes()
                startSnowflakes()
                snowflakeContainer.Visible = true
            end
        end
    end
    
    -- Speed keybind
    if speedKeybind and i.KeyCode.Name == speedKeybind then
        toggleSpeedGlobal()
    end
    
    -- Enter key to confirm speed keybind TextBox (if focused)
    if i.KeyCode == Enum.KeyCode.Return and activeTextBox then
        activeTextBox:ReleaseFocus()
    end
end)

