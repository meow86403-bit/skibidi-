-- === FOV AIMBOT FUNCTIONS ===
local function aimAtPosition(targetPos)
    local char = player.Character
    if not char then return end
    
    local lookDir = (targetPos - camera.CFrame.Position).Unit
    local targetCFrame = CFrame.lookAt(camera.CFrame.Position, camera.CFrame.Position + lookDir)
    
    if fovAimbotSmoothness <= 1 then
        camera.CFrame = targetCFrame
    else
        camera.CFrame = camera.CFrame:Lerp(targetCFrame, 1 / fovAimbotSmoothness)
    end
end

local function startFovAimbot()
    if fovAimbotConnection then
        fovAimbotConnection:Disconnect()
        fovAimbotConnection = nil
    end
    
    fovAimbotConnection = RunService.RenderStepped:Connect(function()
        if not rightMouseDown or not drawFovEnabled then
            if fovLockedTarget then
                fovLockedTarget = nil
            end
            return
        end
        
        local mousePos = UserInputService:GetMouseLocation()
        
        if fovLockedTarget then
            local targetChar = fovLockedTarget.Character
            if targetChar then
                local targetHumanoid = targetChar:FindFirstChild("Humanoid")
                local aimPos = getAimPosition(targetChar)
                if aimPos and targetHumanoid and targetHumanoid.Health > 0 then
                    local screenPos, onScreen = worldToScreen(aimPos)
                    if onScreen then
                        local dist = (screenPos - mousePos).Magnitude
                        if dist <= fovRadius then
                            aimAtPosition(aimPos)
                            return
                        end
                    end
                end
            end
            fovLockedTarget = nil
        end
        
        local closestPlayer = getClosestPlayerInFOV(mousePos, fovRadius)
        
        if closestPlayer then
            fovLockedTarget = closestPlayer
            local targetChar = closestPlayer.Character
            if targetChar then
                local aimPos = getAimPosition(targetChar)
                if aimPos then
                    aimAtPosition(aimPos)
                end
            end
        end
    end)
end

local function stopFovAimbot()
    if fovAimbotConnection then
        fovAimbotConnection:Disconnect()
        fovAimbotConnection = nil
    end
    fovLockedTarget = nil
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton2 and drawFovEnabled then
        rightMouseDown = true
        if not fovAimbotConnection then
            startFovAimbot()
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        rightMouseDown = false
        fovLockedTarget = nil
    end
end)

-- === NO CLIP FUNCTION ===
local function applyNoClip(state)
    local char = player.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

-- === ESP CORE ===
local function createESPBox(targetPlayer)
    if espObjects[targetPlayer] then
        destroyESPBox(targetPlayer)
    end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = COLORS.ESP
    highlight.FillTransparency = 1
    highlight.OutlineColor = COLORS.ESP
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = targetPlayer.Character
    highlight.Parent = targetPlayer.Character
    
    espObjects[targetPlayer] = highlight
    
    local charConnection
    charConnection = targetPlayer.CharacterAdded:Connect(function(newChar)
        if espEnabled and espObjects[targetPlayer] then
            espObjects[targetPlayer].Adornee = newChar
            if not espObjects[targetPlayer].Parent then
                espObjects[targetPlayer].Parent = newChar
            end
        else
            if charConnection then charConnection:Disconnect() end
        end
    end)
    espConnections[targetPlayer] = charConnection
end

local function destroyESPBox(targetPlayer)
    if espObjects[targetPlayer] then
        espObjects[targetPlayer]:Destroy()
        espObjects[targetPlayer] = nil
    end
    if espConnections[targetPlayer] then
        espConnections[targetPlayer]:Disconnect()
        espConnections[targetPlayer] = nil
    end
end

local function refreshESP()
    for plr, _ in pairs(espObjects) do
        destroyESPBox(plr)
    end
    espObjects = {}
    for _, conn in pairs(espConnections) do
        conn:Disconnect()
    end
    espConnections = {}
    
    if not espEnabled then return end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            createESPBox(plr)
        end
    end
end

local function toggleESP(state)
    espEnabled = state
    if espEnabled then
        refreshESP()
        if espUpdateConnection then espUpdateConnection:Disconnect() end
        espUpdateConnection = RunService.Heartbeat:Connect(function()
            if not espEnabled then return end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                    if not espObjects[plr] then
                        createESPBox(plr)
                    end
                end
            end
        end)
        if espPlayerAddedConnection then espPlayerAddedConnection:Disconnect() end
        espPlayerAddedConnection = Players.PlayerAdded:Connect(function(newPlr)
            if espEnabled and newPlr ~= player then
                newPlr.CharacterAdded:Connect(function()
                    if espEnabled then
                        createESPBox(newPlr)
                    end
                end)
                if newPlr.Character then
                    createESPBox(newPlr)
                end
            end
        end)
    else
        for plr, _ in pairs(espObjects) do
            destroyESPBox(plr)
        end
        espObjects = {}
        for _, conn in pairs(espConnections) do
            conn:Disconnect()
        end
        espConnections = {}
        if espUpdateConnection then
            espUpdateConnection:Disconnect()
            espUpdateConnection = nil
        end
        if espPlayerAddedConnection then
            espPlayerAddedConnection:Disconnect()
            espPlayerAddedConnection = nil
        end
    end
end

-- === FLIGHT FUNCTIONS ===
local function enableFly()
    if flying then return end
    flying = true
    currentVelocity = Vector3.new(0, 0, 0)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end
    hum.PlatformStand = true
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = root
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root
    
    if noClipEnabled then
        task.wait(0.05)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

local function disableFly()
    if not flying then return end
    flying = false
    currentVelocity = Vector3.new(0, 0, 0)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end
    hum.PlatformStand = false
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
end

RunService.Heartbeat:Connect(function(deltaTime)
    if not flying then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local camLook = camera.CFrame.LookVector
    local camRight = camera.CFrame.RightVector
    local forwardFlat = Vector3.new(camLook.X, 0, camLook.Z).Unit
    if forwardFlat.Magnitude < 0.001 then forwardFlat = Vector3.new(0, 0, 1) end
    local rightFlat = Vector3.new(camRight.X, 0, camRight.Z).Unit
    if rightFlat.Magnitude < 0.001 then rightFlat = Vector3.new(1, 0, 0) end
    local moveDirection = Vector3.new(0, 0, 0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + forwardFlat end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - forwardFlat end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - rightFlat end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + rightFlat end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end
    if moveDirection.Magnitude > 0 then moveDirection = moveDirection.Unit * flySpeed end
    local targetVelocity = moveDirection
    currentVelocity = currentVelocity:Lerp(targetVelocity, 1 - math.exp(-flyAcceleration * deltaTime))
    if bodyVelocity then bodyVelocity.Velocity = currentVelocity end
    if bodyGyro then bodyGyro.CFrame = CFrame.lookAt(root.Position, root.Position + camLook * 10) end
end)

