-- === UTILITY ===
local function worldToScreen(worldPos)
    local sp, on = camera:WorldToViewportPoint(worldPos)
    return Vector2.new(sp.X, sp.Y), on
end

local function getClosestPlayerToCursor()
    local mp = UserInputService:GetMouseLocation()
    local best, bestDist = nil, 200
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and not isWhitelisted(plr) then
            local hum = plr.Character:FindFirstChild("Humanoid")
            local head = plr.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and head then
                local sp, on = worldToScreen(head.Position)
                if on then
                    local dist = (sp - mp).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = plr
                    end
                end
            end
        end
    end
    return best
end

local function getClosestPlayerInFOV(mp, fr)
    local best, bestDist = nil, fr
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and not isWhitelisted(plr) then
            if aimTeamCheckEnabled and plr.Team == player.Team then continue end
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local ap = fovTarget == "Torso" and (plr.Character:FindFirstChild("UpperTorso") or plr.Character:FindFirstChild("Torso")) or plr.Character:FindFirstChild("Head")
                if ap then
                    local sp, on = worldToScreen(ap.Position)
                    if on and (sp-mp).Magnitude <= fr and (sp-mp).Magnitude < bestDist then
                        bestDist = (sp-mp).Magnitude
                        best = plr
                    end
                end
            end
        end
    end
    return best
end

local function getAimPosition(tc)
    if fovTarget == "Torso" then
        local t = tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso")
        if t then return t.Position end
    end
    local h = tc:FindFirstChild("Head")
    return h and h.Position
end

-- === ORBIT ===
local function stopOrbit()
    if not orbitActive then return end
    orbitActive = false
    orbitTarget = nil
    
    if orbitConnection then
        orbitConnection:Disconnect()
        orbitConnection = nil
    end
    
    if orbitBodyGyro then
        orbitBodyGyro:Destroy()
        orbitBodyGyro = nil
    end
    
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.Velocity = Vector3.new(0, 0, 0)
            root.RotVelocity = Vector3.new(0, 0, 0)
            for _, v in ipairs(root:GetChildren()) do
                if v:IsA("BodyGyro") then
                    if v ~= flyBodyGyro then
                        v:Destroy()
                    end
                end
            end
        end
        local hum = char:FindFirstChild("Humanoid")
        if hum and not flying then
            hum.PlatformStand = false
        end
        
        if orbitOriginalPos then
            if root then
                root.CFrame = orbitOriginalPos
            end
            orbitOriginalPos = nil
        end
        
        -- Reset camera to default
        local hum2 = char:FindFirstChild("Humanoid")
        if hum2 then
            camera.CameraSubject = hum2
        end
        camera.CameraType = Enum.CameraType.Custom
    end
end

local function startOrbit(targetPlayer)
    if orbitActive then
        stopOrbit()
        return
    end
    
    if flying then return end
    
    local target = targetPlayer or getClosestPlayerToCursor()
    if not target or not target.Character or isWhitelisted(target) then return end
    if orbitTeamCheckEnabled and target.Team == player.Team then return end
    
    local targetChar = target.Character
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    
    local localChar = player.Character
    if not localChar then return end
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    local localHum = localChar:FindFirstChild("Humanoid")
    if not localRoot or not localHum then return end
    
    orbitOriginalPos = localRoot.CFrame
    
    orbitActive = true
    orbitTarget = target
    
    localHum.PlatformStand = true
    
    local targetFacing = targetRoot.CFrame.LookVector
    targetFacing = Vector3.new(targetFacing.X, 0, targetFacing.Z)
    if targetFacing.Magnitude < 0.01 then targetFacing = Vector3.new(0, 0, -1) end
    targetFacing = targetFacing.Unit
    
    local yOffset = (orbitType == "Up") and orbitHeight or 0
    local behindPos = targetRoot.Position - targetFacing * orbitRadius * 0.7 + Vector3.new(0, yOffset, 0)
    localRoot.CFrame = CFrame.lookAt(behindPos, targetRoot.Position)
    
    camera.CameraSubject = localHum
    camera.CameraType = Enum.CameraType.Custom
    
    if orbitBodyGyro then orbitBodyGyro:Destroy() end
    orbitBodyGyro = Instance.new("BodyGyro")
    orbitBodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
    orbitBodyGyro.P = 10000
    orbitBodyGyro.Parent = localRoot
    
    local angle = math.pi
    
    orbitConnection = RunService.Heartbeat:Connect(function(dt)
        if not orbitActive then return end
        
        -- Check if target still valid (for manual mode)
        if not orbitTarget or not orbitTarget.Character then
            stopOrbit()
            return
        end
        
        local tChar = orbitTarget.Character
        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then
            stopOrbit()
            return
        end
        
        local lChar = player.Character
        if not lChar then
            stopOrbit()
            return
        end
        local lRoot = lChar:FindFirstChild("HumanoidRootPart")
        if not lRoot then
            stopOrbit()
            return
        end
        
        local orbitPos
        
        if orbitType == "Crazy" then
            local randomAngleH = math.random() * math.pi * 2
            local randomAngleV = (math.random() - 0.5) * math.pi
            local randomRadius = orbitRadius * (0.3 + math.random())
            local randomY = math.sin(randomAngleV) * orbitRadius * 0.8
            
            local offsetX = math.cos(randomAngleH) * randomRadius
            local offsetZ = math.sin(randomAngleH) * randomRadius
            
            orbitPos = tRoot.Position + Vector3.new(offsetX, randomY, offsetZ)
            
            if math.random() < 0.2 then
                orbitPos = tRoot.Position - Vector3.new(offsetX, randomY, offsetZ)
            end
        else
            angle = angle + orbitSpeed * dt
            if angle > math.pi * 2 then
                angle = angle - math.pi * 2
            end
            
            local swingAngle
            if orbitMode == "Stay" then
                swingAngle = 0
            else
                swingAngle = math.sin(angle) * 0.9
            end
            
            local targetFacing = tRoot.CFrame.LookVector
            targetFacing = Vector3.new(targetFacing.X, 0, targetFacing.Z)
            if targetFacing.Magnitude < 0.01 then
                targetFacing = Vector3.new(0, 0, -1)
            end
            targetFacing = targetFacing.Unit
            
            local targetRight = Vector3.new(targetFacing.Z, 0, -targetFacing.X).Unit
            
            local yOffset = (orbitType == "Up") and orbitHeight or 0
            
            orbitPos = tRoot.Position 
                - targetFacing * orbitRadius * 0.7
                + targetRight * swingAngle * orbitRadius
                + Vector3.new(0, yOffset, 0)
        end
        
        lRoot.CFrame = CFrame.lookAt(orbitPos, tRoot.Position)
        
        local head = lChar:FindFirstChild("Head")
        if head then
            camera.CFrame = CFrame.lookAt(head.Position, tRoot.Position)
        end
        
        if orbitBodyGyro then
            orbitBodyGyro.CFrame = CFrame.lookAt(lRoot.Position, tRoot.Position)
        end
    end)
end

