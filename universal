RunService:BindToRenderStep("AimbotUpdate", 1, function()
    if fovActive and fovCircle then
        updateFOVCircle()
        
        if locking and currentTarget and currentTarget.Character then
            local target = currentTarget.Character:FindFirstChild("Head") or currentTarget.Character:FindFirstChild("HumanoidRootPart")
            if target then
                workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, target.Position)
            end
        end
    end
end)

