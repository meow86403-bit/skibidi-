-- ESP Functions
local function createESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local highlight = Instance.new("Highlight")
                highlight.Name = "ESP_Highlight_" .. player.Name
                highlight.Adornee = char
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.FillTransparency = 0.7
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.OutlineTransparency = 0.3
                highlight.Parent = screenGui
                espBoxes[player] = highlight
                
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "ESP_Name_" .. player.Name
                billboard.Size = UDim2.new(0, 200, 0, 30)
                billboard.Adornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                billboard.StudsOffset = Vector3.new(0, 2, 0)
                billboard.AlwaysOnTop = true
                billboard.Parent = screenGui
                
                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, 0, 1, 0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = player.Name .. " [" .. math.floor((player:DistanceFromCharacter(LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.zero)) / 3) .. "m]"
                nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                nameLabel.TextSize = 14
                nameLabel.Font = Enum.Font.GothamBold
                nameLabel.TextStrokeTransparency = 0.3
                nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                nameLabel.Parent = billboard
                
                espNames[player] = billboard
            end
        end
    end
end

local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                if not espBoxes[player] or not espBoxes[player].Parent then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESP_Highlight_" .. player.Name
                    highlight.Adornee = char
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.FillTransparency = 0.7
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.OutlineTransparency = 0.3
                    highlight.Parent = screenGui
                    espBoxes[player] = highlight
                else
                    espBoxes[player].Adornee = char
                end
                
                local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                if head then
                    if not espNames[player] or not espNames[player].Parent then
                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "ESP_Name_" .. player.Name
                        billboard.Size = UDim2.new(0, 200, 0, 30)
                        billboard.Adornee = head
                        billboard.StudsOffset = Vector3.new(0, 2, 0)
                        billboard.AlwaysOnTop = true
                        billboard.Parent = screenGui
                        
                        local nameLabel = Instance.new("TextLabel")
                        nameLabel.Size = UDim2.new(1, 0, 1, 0)
                        nameLabel.BackgroundTransparency = 1
                        nameLabel.Text = player.Name
                        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                        nameLabel.TextSize = 14
                        nameLabel.Font = Enum.Font.GothamBold
                        nameLabel.TextStrokeTransparency = 0.3
                        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        nameLabel.Parent = billboard
                        
                        espNames[player] = billboard
                    else
                        espNames[player].Adornee = head
                        local label = espNames[player]:FindFirstChildOfClass("TextLabel")
                        if label then
                            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local dist = hrp and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and math.floor((player.Character.HumanoidRootPart.Position - hrp.Position).Magnitude / 3) or 0
                            label.Text = player.Name .. " [" .. dist .. "m]"
                        end
                    end
                end
            else
                if espBoxes[player] then
                    espBoxes[player]:Destroy()
                    espBoxes[player] = nil
                end
                if espNames[player] then
                    espNames[player]:Destroy()
                    espNames[player] = nil
                end
            end
        end
    end
end

local function clearESP()
    for _, box in pairs(espBoxes) do
        pcall(function() box:Destroy() end)
    end
    for _, name in pairs(espNames) do
        pcall(function() name:Destroy() end)
    end
    espBoxes = {}
    espNames = {}
end

local function startESP()
    espEnabled = true
    createESP()
    
    RunService:BindToRenderStep("ESPUpdate", 1, function()
        if espEnabled then
            updateESP()
        end
    end)
end

local function stopESP()
    espEnabled = false
    RunService:UnbindFromRenderStep("ESPUpdate")
    clearESP()
end

local function toggleESP()
    if espEnabled then
        stopESP()
        espToggleButton.Text = "ESP: OFF"
        espToggleIndicator.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        espIndicatorCircle.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
        espIndicatorCircle.Position = UDim2.new(0, 3, 0.5, -13)
    else
        startESP()
        espToggleButton.Text = "ESP: ON"
        espToggleIndicator.BackgroundColor3 = Color3.fromRGB(70, 150, 70)
        espIndicatorCircle.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        espIndicatorCircle.Position = UDim2.new(0, 11, 0.5, -13)
    end
end

