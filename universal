-- ============ UI STATE MANAGEMENT ============
local currentState = "main" -- main, universal, settings

local function switchToMainUI()
    currentState = "main"
    titleLabel.Text = "Universal Script"
    titleLabel.Position = UDim2.new(0, 58, 0, 0)
    backButton.Visible = false
    mainContent.Visible = true
    universalContent.Visible = false
    settingsContent.Visible = false
    closeButton.Visible = true
    settingsButton.Visible = true
end

local function switchToUniversalUI()
    currentState = "universal"
    titleLabel.Text = "Universal"
    titleLabel.Position = UDim2.new(0, 58, 0, 0)
    backButton.Visible = true
    mainContent.Visible = false
    universalContent.Visible = true
    settingsContent.Visible = false
    closeButton.Visible = true
    settingsButton.Visible = true
end

local function switchToSettingsUI()
    currentState = "settings"
    titleLabel.Text = "Settings"
    titleLabel.Position = UDim2.new(0, 58, 0, 0)
    backButton.Visible = true
    mainContent.Visible = false
    universalContent.Visible = false
    settingsContent.Visible = true
    closeButton.Visible = true
    settingsButton.Visible = true
end

-- Back button: returns to main UI
backButton.MouseButton1Click:Connect(function()
    switchToMainUI()
end)

-- Open Universal Script button
openUniversalButton.MouseButton1Click:Connect(function()
    switchToUniversalUI()
end)

-- Settings button toggles
settingsButton.MouseButton1Click:Connect(function()
    if currentState == "settings" then
        switchToMainUI()
    else
        switchToSettingsUI()
    end
end)

-- ============ DRAGGING LOGIC ============
local dragging = false
local dragStart, startPos

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Animation
mainFrame.BackgroundTransparency = 0.35
TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {BackgroundTransparency = 0}):Play()

