local function createMinCircle()
    if minimizeCircle then minimizeCircle:Destroy() end
    minimizeCircle = Instance.new("TextButton")
    minimizeCircle.Size = UDim2.new(0, 50, 0, 50)
    minimizeCircle.Position = UDim2.new(0.5, -25, 0, 10)
    minimizeCircle.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
    minimizeCircle.Text = "UN"
    minimizeCircle.TextColor3 = Color3.fromRGB(255, 255, 255)
    minimizeCircle.TextSize = 18
    minimizeCircle.Font = Enum.Font.GothamBold
    minimizeCircle.AutoButtonColor = false
    minimizeCircle.Parent = screenGui
    
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = minimizeCircle
    
    minimizeCircle.MouseButton1Click:Connect(function()
        minimizeCircle:Destroy()
        minimizeCircle = nil
        mainFrame.Visible = true
        isMinimized = false
    end)
end

minimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = true
    mainFrame.Visible = false
    createMinCircle()
end)

closeBtn.MouseButton1Click:Connect(function()
    if flying then stopFly() end
    if espEnabled then stopESP() end
    if boxEspEnabled then stopBoxESP() end
    if autoTPEnabled then stopAutoTP() end
    if noClipEnabled then stopNoClip() end
    
    RunService:UnbindFromRenderStep("ESPUpdate")
    RunService:UnbindFromRenderStep("BoxESPUpdate")
    RunService:UnbindFromRenderStep("FlyMovement")
    RunService:UnbindFromRenderStep("AimbotUpdate")
    
    if minimizeCircle then minimizeCircle:Destroy() end
    screenGui:Destroy()
end)

-- Dragging
local dragging = false
local dragStart, startPos

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

