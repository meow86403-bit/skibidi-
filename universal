    titleLabel.Text = "Universal"
    backButton.Visible = true
    tabBar.Visible = false
    mainContent.Visible = false
    gamesContent.Visible = false
    settingsContent.Visible = false
    universalContent.Visible = true
    brainrotContent.Visible = false
    breatheContent.Visible = false
end

local function switchToBrainrotUI()
    currentState = "brainrot"
    titleLabel.Text = "Brainrot"
    backButton.Visible = true
    tabBar.Visible = false
    mainContent.Visible = false
    gamesContent.Visible = false
    settingsContent.Visible = false
    universalContent.Visible = false
    brainrotContent.Visible = true
    breatheContent.Visible = false
end

local function switchToBreatheUI()
    currentState = "breathe"
    titleLabel.Text = "breathe fire for brainrots script"
    backButton.Visible = true
    tabBar.Visible = false
    mainContent.Visible = false
    gamesContent.Visible = false
    settingsContent.Visible = false
    universalContent.Visible = false
    brainrotContent.Visible = false
    breatheContent.Visible = true
end

-- Tab clicks
mainTab.MouseButton1Click:Connect(function()
    if currentState == "mainTab" then return end
    switchToMainTab()
end)

gamesTab.MouseButton1Click:Connect(function()
    if currentState == "gamesTab" then return end
    switchToGamesTab()
end)

settingsTab.MouseButton1Click:Connect(function()
    if currentState == "settingsTab" then return end
    switchToSettingsTab()
end)

-- Button clicks
openUniversalButton.MouseButton1Click:Connect(function()
    switchToUniversalUI()
end)

brainrotGameButton.MouseButton1Click:Connect(function()
    switchToBrainrotUI()
end)

breatheGameButton.MouseButton1Click:Connect(function()
    switchToBreatheUI()
end)

-- Back button
backButton.MouseButton1Click:Connect(function()
    if currentState == "universal" then
        switchToMainTab()
    elseif currentState == "brainrot" or currentState == "breathe" then
        switchToGamesTab()
    else
        switchToMainTab()
    end
end)

-- Dragging
local dragging = false
local dragStart, startPos

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

mainFrame.BackgroundTransparency = 0.35
TweenService:Create(mainFrame, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()

print("Universal Script UI Loaded")
