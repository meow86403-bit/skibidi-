local function dropPlayerFiveThousand()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return end
    
    local originalPos = hrp.Position
    local targetY = originalPos.Y - 5000
    
    humanoid.PlatformStand = true
    local tweenInfo = TweenInfo.new(2, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {Position = Vector3.new(originalPos.X, targetY, originalPos.Z)})
    tween:Play()
    tween.Completed:Connect(function()
        humanoid.PlatformStand = false
    end)
end

UserInputService.JumpRequest:Connect(function()
    if stupidEnabled then
        task.wait(0.05)
        dropPlayerFiveThousand()
    end
end)

