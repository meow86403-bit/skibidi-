local function getClosestPlayerInFOV()
    local mouse = LocalPlayer:GetMouse()
    local closestPlayer = nil
    local closestDistance = fovRadius
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos, on = workspace.CurrentCamera:WorldToScreenPoint(hrp.Position)
                if on then
                    local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                    if dist < closestDistance then
                        closestDistance = dist
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

UserInputService.InputBegan:Connect(function(input)
    if fovEnabled and input.UserInputType == Enum.UserInputType.MouseButton2 then
        isMouseDown = true
        currentLockTarget = getClosestPlayerInFOV()
        if currentLockTarget then
            targetVelocities[currentLockTarget] = {lastPos = nil, lastTime = nil, velocity = Vector3.new(0, 0, 0)}
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isMouseDown = false
        currentLockTarget = nil
    end
end)

RunService:BindToRenderStep("FOVUpdate", 1, function()
    if fovEnabled and fovCircle then
        local mouse = LocalPlayer:GetMouse()
        fovCircle.Position = UDim2.new(0, mouse.X - fovRadius, 0, mouse.Y - fovRadius)
        if isMouseDown and currentLockTarget and currentLockTarget.Character then
            local targetPart = currentLockTarget.Character:FindFirstChild("Head") or currentLockTarget.Character:FindFirstChild("HumanoidRootPart")
            if targetPart then
                local targetPos = targetPart.Position
                if predictionEnabled then
                    local targetVel = Vector3.new(0, 0, 0)
                    local rootPart = currentLockTarget.Character:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        local velData = targetVelocities[currentLockTarget]
                        if not velData then
                            velData = {lastPos = nil, lastTime = nil, velocity = Vector3.new(0, 0, 0)}
                            targetVelocities[currentLockTarget] = velData
                        end
                        if not velData.lastPos then
                            velData.lastPos = rootPart.Position
                            velData.lastTime = tick()
                        else
                            local dt = math.min(0.1, tick() - velData.lastTime)
                            if dt > 0 then
                                targetVel = (rootPart.Position - velData.lastPos) / dt
                                velData.velocity = targetVel
                                velData.lastPos = rootPart.Position
                                velData.lastTime = tick()
                            else
                                targetVel = velData.velocity
                            end
                        end
                    end
                    local camPos = workspace.CurrentCamera.CFrame.Position
                    local dist = (targetPos - camPos).Magnitude
                    local travelTime = dist / 3000
                    local predictedPos = targetPos + (targetVel * travelTime * predictionStrength)
                    workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, predictedPos)
                else
                    workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, targetPos)
                end
            end
        end
    end
end)

