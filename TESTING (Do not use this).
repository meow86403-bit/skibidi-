local function createBoxESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "BoxESP_" .. player.Name
                billboard.Adornee = char:FindFirstChild("HumanoidRootPart")
                billboard.Size = UDim2.new(4, 0, 5.5, 0)
                billboard.AlwaysOnTop = true
                billboard.Parent = screenGui
                
                local boxFrame = Instance.new("Frame")
                boxFrame.Size = UDim2.new(1, 0, 1, 0)
                boxFrame.BackgroundTransparency = 1
                boxFrame.BorderSizePixel = 1
                boxFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
                boxFrame.Parent = billboard
                
                local uiStroke = Instance.new("UIStroke")
                uiStroke.Color = Color3.fromRGB(255, 255, 255)
                uiStroke.Thickness = 1.5
                uiStroke.Parent = boxFrame

                boxEspFrames[player] = billboard
            end
        end
    end
end

local function updateBoxESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                if not boxEspFrames[player] or not boxEspFrames[player].Parent then
                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "BoxESP_" .. player.Name
                    billboard.Adornee = char:FindFirstChild("HumanoidRootPart")
                    billboard.Size = UDim2.new(4, 0, 5.5, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = screenGui
                    
                    local boxFrame = Instance.new("Frame")
                    boxFrame.Size = UDim2.new(1, 0, 1, 0)
                    boxFrame.BackgroundTransparency = 1
                    boxFrame.BorderSizePixel = 1
                    boxFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
                    boxFrame.Parent = billboard
                    
                    local uiStroke = Instance.new("UIStroke")
                    uiStroke.Color = Color3.fromRGB(255, 255, 255)
                    uiStroke.Thickness = 1.5
                    uiStroke.Parent = boxFrame

                    boxEspFrames[player] = billboard
                else
                    boxEspFrames[player].Adornee = char:FindFirstChild("HumanoidRootPart")
                end
            else
                if boxEspFrames[player] then
                    boxEspFrames[player]:Destroy()
                    boxEspFrames[player] = nil
                end
            end
        end
    end
end

local function clearBoxESP()
    for _, box in pairs(boxEspFrames) do
        pcall(function() box:Destroy() end)
    end
    boxEspFrames = {}
end

local function startBoxESP()
    boxEspEnabled = true
    createBoxESP()
    
    RunService:BindToRenderStep("BoxESPUpdate", 1, function()
        if boxEspEnabled then
            updateBoxESP()
        end
    end)
end

local function stopBoxESP()
    boxEspEnabled = false
    RunService:UnbindFromRenderStep("BoxESPUpdate")
    clearBoxESP()
end

local function toggleBoxESP()
    if boxEspEnabled then
        stopBoxESP()
        boxEspToggleButton.Text = "Box ESP: OFF"
        boxEspToggleIndicator.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
