local function onCharacterAddedForNoClip(char)
    if noClipEnabled then
        task.wait(0.1)
        applyNoClipToCharacter(char)
        
        char.ChildAdded:Connect(function(child)
            if noClipEnabled and child:IsA("BasePart") then
                if not originalCanCollide[child] then
                    originalCanCollide[child] = child.CanCollide
                end
                child.CanCollide = false
            end
        end)
    end
end

