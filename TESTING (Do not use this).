        local mouse = LocalPlayer:GetMouse()
        local sliderBgPos = fovSliderBg.AbsolutePosition.X
        local sliderBgSize = fovSliderBg.AbsoluteSize.X
        local mouseX = math.clamp(mouse.X - sliderBgPos, 0, sliderBgSize)
        local percentage = mouseX / sliderBgSize
        
        fovRadius = math.floor(10 + (percentage * 90))
        fovSliderFill.Size = UDim2.new(percentage, 0, 1, 0)
        fovSliderButton.Position = UDim2.new(percentage, -8, 0.5, -10)
        fovSliderLabel.Text = "FOV Size: " .. fovRadius
        
        if fovCircle then
            fovCircle.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2)
        end
    end
    
    if predictionDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local mouse = LocalPlayer:GetMouse()
        local sliderBgPos = predictionSliderBg.AbsolutePosition.X
        local sliderBgSize = predictionSliderBg.AbsoluteSize.X
        local mouseX = math.clamp(mouse.X - sliderBgPos, 0, sliderBgSize)
        local percentage = mouseX / sliderBgSize
        updatePredictionStrength(percentage)
    end
end)

local function getClosestPlayerInFOV()
    local mouse = LocalPlayer:GetMouse()
    local closestPlayer = nil
    local closestDistance = fovRadius
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
            if humanoidRootPart then
                local screenPos, onScreen = workspace.CurrentCamera:WorldToScreenPoint(humanoidRootPart.Position)
                if onScreen then
                    local mousePos = Vector2.new(mouse.X, mouse.Y)
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    
                    if distance < closestDistance then
                        closestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

UserInputService.InputBegan:Connect(function(input)
    if fovEnabled and input.UserInputType == Enum.UserInputType.MouseButton2 then
        isMouseDown = true
        currentLockTarget = getClosestPlayerInFOV()
        if currentLockTarget then
            targetVelocities[currentLockTarget] = {
                lastPos = nil,
                lastTime = nil,
                velocity = Vector3.new(0, 0, 0)
            }
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isMouseDown = false
        currentLockTarget = nil
    end
end)

RunService:BindToRenderStep("FOVUpdate", 1, function()
    if fovEnabled and fovCircle then
        local mouse = LocalPlayer:GetMouse()
        fovCircle.Position = UDim2.new(0, mouse.X - fovRadius, 0, mouse.Y - fovRadius)
        
        if isMouseDown and currentLockTarget and currentLockTarget.Character then
            local targetPart = currentLockTarget.Character:FindFirstChild("Head") or currentLockTarget.Character:FindFirstChild("HumanoidRootPart")
            if targetPart then
                local targetPosition = targetPart.Position
                
                if predictionEnabled then
                    local targetVelocity = Vector3.new(0, 0, 0)
                    local rootPart = currentLockTarget.Character:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        local velData = targetVelocities[currentLockTarget]
                        if not velData then
                            velData = {lastPos = nil, lastTime = nil, velocity = Vector3.new(0, 0, 0)}
                            targetVelocities[currentLockTarget] = velData
                        end
                        
                        if not velData.lastPos then
                            velData.lastPos = rootPart.Position
                            velData.lastTime = tick()
                        else
                            local deltaTime = math.min(0.1, tick() - velData.lastTime)
                            if deltaTime > 0 then
                                targetVelocity = (rootPart.Position - velData.lastPos) / deltaTime
                                velData.velocity = targetVelocity
                                velData.lastPos = rootPart.Position
                                velData.lastTime = tick()
                            else
                                targetVelocity = velData.velocity
                            end
                        end
                    end
                    
                    local cameraPos = workspace.CurrentCamera.CFrame.Position
                    local distance = (targetPosition - cameraPos).Magnitude
                    local bulletSpeed = 3000
                    local travelTime = distance / bulletSpeed
                    
                    local predictedOffset = targetVelocity * travelTime * predictionStrength
                    local predictedPosition = targetPosition + predictedOffset
                    
                    workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, predictedPosition)
                else
                    workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, targetPosition)
                end
            end
        end
    end
end)

