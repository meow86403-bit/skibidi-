-- ESP Functions
local function createESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local highlight = Instance.new("Highlight")
                highlight.Name = "ESP_Highlight_" .. player.Name
                highlight.Adornee = char
                highlight.FillTransparency = 1
                highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineTransparency = 0
                highlight.Parent = screenGui
                espBoxes[player] = highlight
            end
        end
    end
end

local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                if not espBoxes[player] then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESP_Highlight_" .. player.Name
                    highlight.Adornee = char
                    highlight.FillTransparency = 1
                    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineTransparency = 0
                    highlight.Parent = screenGui
                    espBoxes[player] = highlight
                else
                    espBoxes[player].Adornee = char
                end
            elseif espBoxes[player] then
                espBoxes[player]:Destroy()
                espBoxes[player] = nil
            end
        end
    end
end

local function clearESP()
    for _, box in pairs(espBoxes) do
        pcall(function() box:Destroy() end)
    end
    espBoxes = {}
end

local function startESP()
    espEnabled = true
    createESP()
    RunService:BindToRenderStep("ESPUpdate", 1, function()
        if espEnabled then updateESP() end
    end)
end

local function stopESP()
    espEnabled = false
    RunService:UnbindFromRenderStep("ESPUpdate")
    clearESP()
end

local function toggleESP()
    if espEnabled then
        stopESP()
        espToggleButton.Text = "ESP: OFF"
        espToggleIndicator.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        espIndicatorCircle.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
        espIndicatorCircle.Position = UDim2.new(0, 3, 0.5, -13)
    else
        startESP()
        espToggleButton.Text = "ESP: ON"
        espToggleIndicator.BackgroundColor3 = Color3.fromRGB(70, 150, 70)
        espIndicatorCircle.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        espIndicatorCircle.Position = UDim2.new(0, 11, 0.5, -13)
    end
end

espToggleButton.MouseButton1Click:Connect(toggleESP)

-- Box ESP Functions
local function createBoxESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "BoxESP_" .. player.Name
                billboard.Adornee = char:FindFirstChild("HumanoidRootPart")
                billboard.Size = UDim2.new(4, 0, 5.5, 0)
                billboard.AlwaysOnTop = true
                billboard.Parent = screenGui
                
                if boxType == "2D" then
                    local boxFrame = Instance.new("Frame")
                    boxFrame.Size = UDim2.new(1, 0, 1, 0)
                    boxFrame.BackgroundTransparency = 1
                    boxFrame.BorderSizePixel = 2
                    boxFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
                    boxFrame.Parent = billboard
                else
                    local cs, lt = 8, 2
                    local function addCorner(px, py, sx, sy)
                        local f = Instance.new("Frame")
                        f.Size = UDim2.new(0, sx, 0, sy)
                        f.Position = UDim2.new(px, 0, py, 0)
                        f.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                        f.BorderSizePixel = 0
                        f.Parent = billboard
                    end
                    addCorner(0, 0, cs, lt)
                    addCorner(0, 0, lt, cs)
                    addCorner(1, 0, -cs, lt)
                    addCorner(1, 0, -lt, cs)
                    addCorner(0, 1, cs, -lt)
                    addCorner(0, 1, lt, -cs)
                    addCorner(1, 1, -cs, -lt)
                    addCorner(1, 1, -lt, -cs)
                end
                boxEspFrames[player] = billboard
            end
        end
    end
end

local function updateBoxESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                if not boxEspFrames[player] then
                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "BoxESP_" .. player.Name
                    billboard.Adornee = char:FindFirstChild("HumanoidRootPart")
                    billboard.Size = UDim2.new(4, 0, 5.5, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = screenGui
                    
                    if boxType == "2D" then
                        local boxFrame = Instance.new("Frame")
                        boxFrame.Size = UDim2.new(1, 0, 1, 0)
                        boxFrame.BackgroundTransparency = 1
                        boxFrame.BorderSizePixel = 2
                        boxFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
                        boxFrame.Parent = billboard
                    else
                        local cs, lt = 8, 2
                        local function addCorner(px, py, sx, sy)
                            local f = Instance.new("Frame")
                            f.Size = UDim2.new(0, sx, 0, sy)
                            f.Position = UDim2.new(px, 0, py, 0)
                            f.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                            f.BorderSizePixel = 0
                            f.Parent = billboard
                        end
                        addCorner(0, 0, cs, lt)
                        addCorner(0, 0, lt, cs)
                        addCorner(1, 0, -cs, lt)
                        addCorner(1, 0, -lt, cs)
                        addCorner(0, 1, cs, -lt)
                        addCorner(0, 1, lt, -cs)
                        addCorner(1, 1, -cs, -lt)
                        addCorner(1, 1, -lt, -cs)
                    end
                    boxEspFrames[player] = billboard
                else
                    boxEspFrames[player].Adornee = char:FindFirstChild("HumanoidRootPart")
                end
            elseif boxEspFrames[player] then
                boxEspFrames[player]:Destroy()
                boxEspFrames[player] = nil
            end
        end
    end
end

local function clearBoxESP()
    for _, box in pairs(boxEspFrames) do
        pcall(function() box:Destroy() end)
    end
    boxEspFrames = {}
end

local function startBoxESP()
    boxEspEnabled = true
    createBoxESP()
    RunService:BindToRenderStep("BoxESPUpdate", 1, function()
        if boxEspEnabled then updateBoxESP() end
    end)
end

local function stopBoxESP()
    boxEspEnabled = false
    RunService:UnbindFromRenderStep("BoxESPUpdate")
    clearBoxESP()
end

