-- Fly Mode Functions
local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    humanoid.PlatformStand = true
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = char:WaitForChild("HumanoidRootPart")
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bodyGyro.Parent = char:WaitForChild("HumanoidRootPart")
    flying = true
    RunService:BindToRenderStep("FlyMovement", 0, function()
        if not flying or not LocalPlayer.Character then return end
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp or not bodyVelocity or not bodyGyro then return end
        local camera = workspace.CurrentCamera
        local moveDirection = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end
        if moveDirection.Magnitude > 0 then moveDirection = moveDirection.Unit * flySpeed end
        bodyVelocity.Velocity = moveDirection
        bodyGyro.CFrame = camera.CFrame
    end)
end

local function stopFly()
    flying = false
    RunService:UnbindFromRenderStep("FlyMovement")
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    bodyVelocity = nil
    bodyGyro = nil
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.PlatformStand = false end
    end
end

local function toggleFly()
    if flying then
        stopFly()
        flyToggleButton.Text = "Fly Mode: OFF"
        flyToggleIndicator.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        flyIndicatorCircle.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
        flyIndicatorCircle.Position = UDim2.new(0, 3, 0.5, -13)
    else
        startFly()
        flyToggleButton.Text = "Fly Mode: ON"
        flyToggleIndicator.BackgroundColor3 = Color3.fromRGB(70, 150, 70)
        flyIndicatorCircle.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        flyIndicatorCircle.Position = UDim2.new(0, 11, 0.5, -13)
    end
end

flyToggleButton.MouseButton1Click:Connect(toggleFly)

-- No Clip Functions
local function toggleNoClip()
    noClipEnabled = not noClipEnabled
    if noClipEnabled then
        local char = LocalPlayer.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    if not originalCanCollide[part] then
                        originalCanCollide[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end
        noClipToggleButton.Text = "No Clip: ON"
        noClipIndicator.BackgroundColor3 = Color3.fromRGB(70, 150, 70)
        noClipIndicatorCircle.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        noClipIndicatorCircle.Position = UDim2.new(0, 11, 0.5, -13)
    else
        for part, canCollide in pairs(originalCanCollide) do
            if part and part.Parent then part.CanCollide = canCollide end
        end
        originalCanCollide = {}
        noClipToggleButton.Text = "No Clip: OFF"
        noClipIndicator.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        noClipIndicatorCircle.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
        noClipIndicatorCircle.Position = UDim2.new(0, 3, 0.5, -13)
    end
end

noClipToggleButton.MouseButton1Click:Connect(toggleNoClip)

-- AutoTP Functions (global)
local function applyForwardVelocity()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.PlatformStand = true end
    if autoTPVelocity then autoTPVelocity:Destroy() end
    if autoTPGyro then autoTPGyro:Destroy() end
    autoTPVelocity = Instance.new("BodyVelocity")
    autoTPVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    autoTPVelocity.Velocity = hrp.CFrame.LookVector * 200
    autoTPVelocity.Parent = hrp
    autoTPGyro = Instance.new("BodyGyro")
    autoTPGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    autoTPGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + hrp.CFrame.LookVector)
    autoTPGyro.Parent = hrp
end

local function stopForwardVelocity()
    if autoTPVelocity then autoTPVelocity:Destroy() end
    if autoTPGyro then autoTPGyro:Destroy() end
    autoTPVelocity = nil
    autoTPGyro = nil
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.PlatformStand = false end
    end
end

local function teleportAndMove()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = CFrame.new(autoTPPosition)
    if autoTPVelocity then autoTPVelocity:Destroy() end
    if autoTPGyro then autoTPGyro:Destroy() end
    autoTPVelocity = Instance.new("BodyVelocity")
    autoTPVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    autoTPVelocity.Velocity = hrp.CFrame.LookVector * 200
    autoTPVelocity.Parent = hrp
    autoTPGyro = Instance.new("BodyGyro")
    autoTPGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    autoTPGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + hrp.CFrame.LookVector)
    autoTPGyro.Parent = hrp
end

local function startAutoTP()
    if autoTPEnabled then return end
    autoTPEnabled = true
    teleportAndMove()
    autoTPConnection = RunService:BindToRenderStep("AutoTP", 0, function()
        if autoTPEnabled then
            teleportAndMove()
            task.wait(0.5)
        end
    end)
end

local function stopAutoTP()
    autoTPEnabled = false
    if autoTPConnection then
        RunService:UnbindFromRenderStep("AutoTP")
        autoTPConnection = nil
    end
    stopForwardVelocity()
end

local function toggleAutoTP()
    if autoTPEnabled then
        stopAutoTP()
    else
        startAutoTP()
    end
end

