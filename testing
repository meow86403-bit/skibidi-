local function refreshPlayerList()
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local entry = Instance.new("Frame")
            entry.Size = UDim2.new(1, 0, 0, 45)
            entry.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
            entry.BorderSizePixel = 0
            entry.Parent = ScrollFrame
            
            local entryCorner = Instance.new("UICorner")
            entryCorner.CornerRadius = UDim.new(0, 6)
            entryCorner.Parent = entry
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Text = plr.DisplayName
            nameLabel.Size = UDim2.new(1, -20, 0, 25)
            nameLabel.Position = UDim2.new(0, 10, 0, 5)
            nameLabel.BackgroundTransparency = 1
            nameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
            nameLabel.TextSize = 16
            nameLabel.Font = Enum.Font.GothamSemibold
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Parent = entry
            
            local userLabel = Instance.new("TextLabel")
            userLabel.Text = "@" .. plr.Name
            userLabel.Size = UDim2.new(1, -20, 0, 18)
            userLabel.Position = UDim2.new(0, 10, 0, 26)
            userLabel.BackgroundTransparency = 1
            userLabel.TextColor3 = Color3.fromRGB(130, 130, 145)
            userLabel.TextSize = 12
            userLabel.Font = Enum.Font.Gotham
            userLabel.TextXAlignment = Enum.TextXAlignment.Left
            userLabel.Parent = entry
            
            entry.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    selectedPlayer = plr
                    SelectedText.Text = "Selected: " .. plr.DisplayName
                    for _, child in ipairs(ScrollFrame:GetChildren()) do
                        if child:IsA("Frame") then
                            child.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
                        end
                    end
                    entry.BackgroundColor3 = Color3.fromRGB(70, 30, 85)
                end
            end)
        end
    end
    
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
end

refreshPlayerList()
Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)

TeleportBtn.MouseButton1Click:Connect(function()
    if selectedPlayer and selectedPlayer.Character then
        local hrp = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        local myChar = player.Character
        if hrp and myChar then
            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
            if myHrp then
                myHrp.CFrame = hrp.CFrame + Vector3.new(0, 3, 0)
            end
        end
    end
end)

SpectateBtn.MouseButton1Click:Connect(function()
    if isSpectating then
        if originalSubject then
            Camera.CameraSubject = originalSubject
        end
        isSpectating = false
        SpectateBtn.Text = "Spectate"
    else
        if selectedPlayer and selectedPlayer.Character then
            local hum = selectedPlayer.Character:FindFirstChild("Humanoid")
            if hum then
                originalSubject = Camera.CameraSubject
                Camera.CameraSubject = hum
                isSpectating = true
                SpectateBtn.Text = "Stop"
            end
        end
    end
end)

-- Tab switching
for i, tab in ipairs(tabs) do
    tab.MouseButton1Click:Connect(function()
        for j, t in ipairs(tabs) do
            t.TextColor3 = Color3.fromRGB(190, 190, 190)
            t.BackgroundTransparency = 1
            t.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            contents[j].Visible = false
        end
        tab.TextColor3 = Color3.fromRGB(255, 100, 255)
        tab.BackgroundTransparency = 0.8
        tab.BackgroundColor3 = Color3.fromRGB(75, 20, 90)
        contents[i].Visible = true
    end)
end

-- Draggable
local dragActive = false
local dragStartPos
local startFramePos

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragActive = true
        dragStartPos = input.Position
        startFramePos = MainFrame.Position
    end
end)

TopBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragActive = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragActive and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStartPos
        MainFrame.Position = UDim2.new(startFramePos.X.Scale, startFramePos.X.Offset + delta.X, startFramePos.Y.Scale, startFramePos.Y.Offset + delta.Y)
    end
end)

print("GUI Loaded Successfully")
