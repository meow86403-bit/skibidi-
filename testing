-- ==================== VARIABLES & FUNCTIONS ====================
local fovEnabled = false
local fovRadius = 120
local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
fovCircle.Thickness = 1.5
fovCircle.Color = Color3.fromRGB(255, 255, 255)
fovCircle.Filled = false
fovCircle.NumSides = 64
fovCircle.Radius = fovRadius

local predEnabled = false
local predAmount = 0.10

local npcEnabled = false

local lockedTarget = nil
local predVelocity = Vector3.zero
local lastPredPos = nil
local lastPredTime = nil
local PRED_SMOOTH = 0.2

local function isValidTarget(plr)
    if not plr or plr == player then return false end
    if not plr.Character then return false end
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    local hum = plr.Character:FindFirstChild("Humanoid")
    return hrp and hum and hum.Health > 0
end

local function isNPC(model)
    if not model or not model:IsA("Model") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end
    if hum.Health <= 0 then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then return false end
    end
    return true
end

local function getClosestPlayerInFOV()
    local closestPlayer = nil
    local closestDistance = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist < fovRadius and dist < closestDistance then
                        closestDistance = dist
                        closestPlayer = plr
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function getClosestNPCInFOV()
    local closestNPC = nil
    local closestDistance = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, model in ipairs(workspace:GetDescendants()) do
        if isNPC(model) then
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if hrp then
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist < fovRadius and dist < closestDistance then
                        closestDistance = dist
                        closestNPC = model
                    end
                end
            end
        end
    end
    return closestNPC
end

local function clearLock()
    lockedTarget = nil
    predVelocity = Vector3.zero
    lastPredPos = nil
    lastPredTime = nil
end

local function applyPrediction(hrpPos)
    local now = tick()
    if lastPredPos and lastPredTime then
        local frameDt = now - lastPredTime
        if frameDt > 0 then
            local rawVel = (hrpPos - lastPredPos) / frameDt
            predVelocity = predVelocity:Lerp(rawVel, PRED_SMOOTH)
        end
    end
    lastPredPos = hrpPos
    lastPredTime = now
    return hrpPos + predVelocity * (predAmount * 0.15)
end

-- ==================== SLIDERS ====================
local sliderDragging = false
local minFOV, maxFOV = 30, 350

local function updateSlider(inputX)
    local trackPos = SliderTrack.AbsolutePosition.X
    local trackSize = SliderTrack.AbsoluteSize.X
    local relative = math.clamp((inputX - trackPos) / trackSize, 0, 1)
    fovRadius = math.floor(minFOV + relative * (maxFOV - minFOV))
    SliderFill.Size = UDim2.new(relative, 0, 1, 0)
    SliderKnob.Position = UDim2.new(relative, 0, 0.5, 0)
    FOVSizeValue.Text = tostring(fovRadius)
    fovCircle.Radius = fovRadius
end

-- FOV Slider events
SliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = true
        updateSlider(input.Position.X)
    end
end)
SliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = true
    end
end)

-- Prediction Slider
local predSliderDragging = false

local function updatePredSlider(inputX)
    local trackPos = PredSliderTrack.AbsolutePosition.X
    local trackSize = PredSliderTrack.AbsoluteSize.X
    local relative = math.clamp((inputX - trackPos) / trackSize, 0, 1)
    predAmount = relative
    PredSliderFill.Size = UDim2.new(relative, 0, 1, 0)
    PredSliderKnob.Position = UDim2.new(relative, 0, 0.5, 0)
    PredSizeValue.Text = math.floor(relative * 100) .. "%"
end

PredSliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        predSliderDragging = true
        updatePredSlider(input.Position.X)
    end
end)
PredSliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        predSliderDragging = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = false
        predSliderDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        updateSlider(input.Position.X)
    elseif predSliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        updatePredSlider(input.Position.X)
    end
end)

