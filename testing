-- ==================== AIMBOT LOOP ====================
RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()

    if fovEnabled then
        fovCircle.Position = mousePos
        fovCircle.Visible = true

        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            if not isValidTarget(lockedTarget) then
                clearLock()
                lockedTarget = getClosestPlayerInFOV()
            end

            local aimPos = nil

            if isValidTarget(lockedTarget) then
                local hrp = lockedTarget.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    aimPos = predEnabled and applyPrediction(hrp.Position) or hrp.Position
                end
            elseif npcEnabled then
                local npcModel = getClosestNPCInFOV()
                if npcModel then
                    local hrp = npcModel:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        aimPos = predEnabled and applyPrediction(hrp.Position) or hrp.Position
                    end
                end
            end

            if aimPos then
                local _, onScreen = Camera:WorldToViewportPoint(aimPos)
                if onScreen then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPos)
                end
            end
        else
            clearLock()
        end
    else
        fovCircle.Visible = false
        clearLock()
    end
end)

