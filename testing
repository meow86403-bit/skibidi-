-- ==================== AIMBOT LOOP ====================
RunService.RenderStepped:Connect(function()
    if fovEnabled then
        local mousePos = UserInputService:GetMouseLocation()
        fovCircle.Position = mousePos
        fovCircle.Visible = true
        
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            if not isValidTarget(lockedTarget) then
                clearLock()
                lockedTarget = getClosestInFOV()
            end
            
            if isValidTarget(lockedTarget) then
                local hrp = lockedTarget.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local aimPos = hrp.Position
                    
                    if predEnabled then
                        local now = tick()
                        if lastPredPos and lastPredTime then
                            local dt = now - lastPredTime
                            if dt > 0 then
                                local vel = (hrp.Position - lastPredPos) / dt
                                predVelocity = predVelocity:Lerp(vel, PRED_SMOOTH)
                            end
                        end
                        lastPredPos = hrp.Position
                        lastPredTime = now
                        aimPos = hrp.Position + predVelocity * (predAmount * 0.2)
                    end
                    
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPos)
                end
            end
        else
            clearLock()
        end
    else
        fovCircle.Visible = false
        clearLock()
    end
end)

