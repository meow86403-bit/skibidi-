local function applyForwardVelocity()
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand = true
    end
    
    if autoTPVelocity then
        autoTPVelocity:Destroy()
    end
    if autoTPGyro then
        autoTPGyro:Destroy()
    end
    
    autoTPVelocity = Instance.new("BodyVelocity")
    autoTPVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    autoTPVelocity.Velocity = hrp.CFrame.LookVector * 200
    autoTPVelocity.Parent = hrp
    
    autoTPGyro = Instance.new("BodyGyro")
    autoTPGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    autoTPGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + hrp.CFrame.LookVector)
    autoTPGyro.Parent = hrp
end

local function stopForwardVelocity()
    if autoTPVelocity then
        autoTPVelocity:Destroy()
        autoTPVelocity = nil
    end
    if autoTPGyro then
        autoTPGyro:Destroy()
        autoTPGyro = nil
    end
    
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
        end
    end
end

local function teleportAndMove()
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    hrp.CFrame = CFrame.new(autoTPPosition)
    
    if autoTPVelocity then
        autoTPVelocity:Destroy()
        autoTPVelocity = nil
    end
    if autoTPGyro then
        autoTPGyro:Destroy()
        autoTPGyro = nil
    end
    
    autoTPVelocity = Instance.new("BodyVelocity")
    autoTPVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    autoTPVelocity.Velocity = hrp.CFrame.LookVector * 200
    autoTPVelocity.Parent = hrp
    
    autoTPGyro = Instance.new("BodyGyro")
    autoTPGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    autoTPGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + hrp.CFrame.LookVector)
    autoTPGyro.Parent = hrp
end

local function startAutoTP()
    if autoTPEnabled then return end
    autoTPEnabled = true
    
    teleportAndMove()
    
    autoTPConnection = RunService:BindToRenderStep("AutoTP", 0, function()
        if autoTPEnabled then
            teleportAndMove()
            task.wait(0.5)
        end
    end)
end

local function stopAutoTP()
    autoTPEnabled = false
    if autoTPConnection then
        RunService:UnbindFromRenderStep("AutoTP")
        autoTPConnection = nil
    end
    stopForwardVelocity()
end

local function toggleAutoTP()
    if autoTPEnabled then
        stopAutoTP()
        autoTPToggleButton.Text = "AutoTP: OFF"
        autoTPToggleIndicator.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        autoTPIndicatorCircle.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
        autoTPIndicatorCircle.Position = UDim2.new(0, 3, 0.5, -13)
    else
        startAutoTP()
        autoTPToggleButton.Text = "AutoTP: ON"
        autoTPToggleIndicator.BackgroundColor3 = Color3.fromRGB(70, 150, 70)
        autoTPIndicatorCircle.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        autoTPIndicatorCircle.Position = UDim2.new(0, 11, 0.5, -13)
    end
end

