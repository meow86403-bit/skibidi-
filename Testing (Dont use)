-- ==================== UNIVERSAL LOCK ====================
local universalLockEnabled = false
local lockedEntity = nil
local universalPredVelocity = Vector3.zero
local universalLastPos = nil
local universalLastTime = nil
local entityType = nil
local PRED_SMOOTH = 0.2

local function isValidTarget(plr)
    if not plr or plr == player then return false end
    if not plr.Character then return false end
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    local hum = plr.Character:FindFirstChild("Humanoid")
    return hrp and hum and hum.Health > 0
end

local function getClosestPlayerInFOV()
    local closestPlayer = nil
    local closestDistance = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                if dist < fovRadius and dist < closestDistance then
                    closestDistance = dist
                    closestPlayer = plr
                end
            end
        end
    end
    return closestPlayer
end

local function getAllNPCs()
    local npcs = {}
    local allDescendants = workspace:GetDescendants()
    for _, obj in ipairs(allDescendants) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health and hum.Health > 0 then
                local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
                if rootPart then
                    local isPlayer = false
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr.Character == obj then
                            isPlayer = true
                            break
                        end
                    end
                    if not isPlayer then
                        table.insert(npcs, {
                            model = obj,
                            hum = hum,
                            rootPart = rootPart
                        })
                    end
                end
            end
        end
    end
    return npcs
end

local function getClosestEntityInFOV()
    if not universalLockEnabled then
        return getClosestPlayerInFOV(), "player"
    end
    
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closestEntity = nil
    local closestDistance = math.huge
    local closestType = nil
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                if dist < fovRadius and dist < closestDistance then
                    closestDistance = dist
                    closestEntity = plr
                    closestType = "player"
                end
            end
        end
    end
    
    local npcs = getAllNPCs()
    for _, npc in ipairs(npcs) do
        if npc.rootPart and npc.hum and npc.hum.Health > 0 then
            local screenPos, onScreen = Camera:WorldToViewportPoint(npc.rootPart.Position)
            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                if dist < fovRadius and dist < closestDistance then
                    closestDistance = dist
                    closestEntity = npc
                    closestType = "npc"
                end
            end
        end
    end
    
    return closestEntity, closestType
end

local function clearUniversalLock()
    lockedEntity = nil
    universalPredVelocity = Vector3.zero
    universalLastPos = nil
    universalLastTime = nil
    entityType = nil
end

NpcCheckbox.MouseButton1Click:Connect(function()
    universalLockEnabled = not universalLockEnabled
    NpcCheckbox.BackgroundColor3 = universalLockEnabled and Color3.fromRGB(140, 60, 200) or Color3.fromRGB(40, 40, 45)
    clearUniversalLock()
end)

RunService.RenderStepped:Connect(function(dt)
    local mousePos = UserInputService:GetMouseLocation()

    if fovEnabled then
        fovCircle.Position = mousePos
        fovCircle.Visible = true

        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            if not universalLockEnabled then
                if not isValidTarget(lockedEntity) then
                    clearUniversalLock()
                    lockedEntity = getClosestPlayerInFOV()
                    entityType = "player"
                end

                if isValidTarget(lockedEntity) then
                    local hrp = lockedEntity.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local aimPos = hrp.Position

                        if predEnabled then
                            local now = tick()
                            if universalLastPos and universalLastTime then
                                local frameDt = now - universalLastTime
                                if frameDt > 0 then
                                    local rawVel = (hrp.Position - universalLastPos) / frameDt
                                    universalPredVelocity = universalPredVelocity:Lerp(rawVel, PRED_SMOOTH)
                                end
                            end
                            universalLastPos = hrp.Position
                            universalLastTime = tick()
                            aimPos = hrp.Position + universalPredVelocity * (predAmount * 0.15)
                        else
                            universalPredVelocity = Vector3.zero
                            universalLastPos = nil
                            universalLastTime = nil
                        end

                        local _, onScreen = Camera:WorldToViewportPoint(aimPos)
                        if onScreen then
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPos)
                        end
                    end
                end
            else
                if not lockedEntity or (entityType == "player" and not isValidTarget(lockedEntity)) or (entityType == "npc" and (not lockedEntity.rootPart or not lockedEntity.hum or lockedEntity.hum.Health <= 0)) then
                    clearUniversalLock()
                    local entity, eType = getClosestEntityInFOV()
                    if entity then
                        lockedEntity = entity
                        entityType = eType
                    end
                end

                if lockedEntity then
                    local aimPos = nil
                    local rootPart = nil
                    
                    if entityType == "player" then
                        local plr = lockedEntity
                        if plr.Character then
                            rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
                            if rootPart then
                                aimPos = rootPart.Position
                            end
                        end
                    else
                        rootPart = lockedEntity.rootPart
                        if rootPart then
                            aimPos = rootPart.Position
                        end
                    end
                    
                    if aimPos and rootPart then
                        if predEnabled then
                            local now = tick()
                            if universalLastPos and universalLastTime then
                                local frameDt = now - universalLastTime
                                if frameDt > 0 then
                                    local rawVel = (rootPart.Position - universalLastPos) / frameDt
                                    universalPredVelocity = universalPredVelocity:Lerp(rawVel, PRED_SMOOTH)
                                end
                            end
                            universalLastPos = rootPart.Position
                            universalLastTime = tick()
                            aimPos = rootPart.Position + universalPredVelocity * (predAmount * 0.15)
                        else
                            universalPredVelocity = Vector3.zero
                            universalLastPos = nil
                            universalLastTime = nil
                        end

                        local _, onScreen = Camera:WorldToViewportPoint(aimPos)
                        if onScreen then
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPos)
                        end
                    end
                end
            end
        else
            clearUniversalLock()
        end
    else
        fovCircle.Visible = false
        clearUniversalLock()
    end
end)

