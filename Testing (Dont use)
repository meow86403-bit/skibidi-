    local yOffset = nameESPEnabled and 32 or 16

    if target then
        lbl.Text = "Looking at: @" .. target.Name
        lbl.Color = Color3.fromRGB(255, 200, 80)
    else
        lbl.Text = "Looking at: nobody"
        lbl.Color = Color3.fromRGB(140, 140, 140)
    end

    lbl.Position = Vector2.new(screenPos.X, baseY + yOffset)
    lbl.Visible = true
end

