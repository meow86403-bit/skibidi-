-- ==================== SKELETON ESP LOGIC ====================
local skeletonEnabled = false
local skeletonLines = {}

local function getJoints(character)
    local joints = {}
    
    local function getPart(name)
        local part = character:FindFirstChild(name)
        return part and part.Position or nil
    end

    local head = getPart("Head")
    local torso = getPart("UpperTorso") or getPart("Torso")
    local lowerTorso = getPart("LowerTorso") or getPart("Torso")
    local lArm = getPart("Left Arm") or getPart("LeftUpperArm")
    local rArm = getPart("Right Arm") or getPart("RightUpperArm")
    local lLeg = getPart("Left Leg") or getPart("LeftUpperLeg")
    local rLeg = getPart("Right Leg") or getPart("RightUpperLeg")

    -- Simple skeleton - just arms, legs, and spine
    if head and torso then
        table.insert(joints, {head, torso})
    end
    if torso and lArm then
        table.insert(joints, {torso, lArm})
    end
    if torso and rArm then
        table.insert(joints, {torso, rArm})
    end
    if torso and lowerTorso then
        table.insert(joints, {torso, lowerTorso})
    end
    if lowerTorso and lLeg then
        table.insert(joints, {lowerTorso, lLeg})
    end
    if lowerTorso and rLeg then
        table.insert(joints, {lowerTorso, rLeg})
    end
    
    return joints
end

local function createSkeletonForPlayer(plr)
    if plr == player then return end
    if skeletonLines[plr] then return end

    skeletonLines[plr] = {}
    for i = 1, 6 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = Color3.fromRGB(255, 255, 255)
        line.Thickness = 1.5
        line.Transparency = 1
        table.insert(skeletonLines[plr], line)
    end
end

local function removeSkeletonForPlayer(plr)
    if not skeletonLines[plr] then return end
    for _, line in ipairs(skeletonLines[plr]) do
        pcall(function() line:Remove() end)
    end
    skeletonLines[plr] = nil
end

local function removeAllSkeletons()
    for plr, _ in pairs(skeletonLines) do
        removeSkeletonForPlayer(plr)
    end
end

local function updateSkeletonForPlayer(plr)
    if not skeletonLines[plr] then return end

    local character = plr.Character
    if not character then
        for _, line in ipairs(skeletonLines[plr]) do
            line.Visible = false
        end
        return
    end

    local joints = getJoints(character)
    local lines = skeletonLines[plr]

    for i = 1, #lines do
        local joint = joints[i]
        if joint and joint[1] and joint[2] then
            local screenA, onA = Camera:WorldToViewportPoint(joint[1])
            local screenB, onB = Camera:WorldToViewportPoint(joint[2])
            if onA and onB then
                lines[i].From = Vector2.new(screenA.X, screenA.Y)
                lines[i].To = Vector2.new(screenB.X, screenB.Y)
                lines[i].Visible = true
            else
                lines[i].Visible = false
            end
        else
            lines[i].Visible = false
        end
    end
end

