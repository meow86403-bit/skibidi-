-- ==================== HOVER FUNCTIONS ====================
local function stopHover()
    if hoverConnection then
        hoverConnection:Disconnect()
        hoverConnection = nil
    end
    hoverTarget = nil
    isHovering = false

    teleportToOriginalPosition()

    local character = player.Character
    if character then
        local hum = character:FindFirstChild("Humanoid")
        if hum then
            hum.AutoRotate = true
            hum.PlatformStand = false
        end
    end
end

local function startHover(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end

    saveOriginalPosition()

    local character = player.Character
    if not character then return false end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChild("Humanoid")
    if not hrp or not hum then return false end

    hoverTarget = targetPlayer
    isHovering = true

    hum.AutoRotate = false
    hum.PlatformStand = true

    hoverConnection = RunService.Heartbeat:Connect(function()
        if not isHovering or not hoverTarget or not hoverTarget.Character then
            stopHover()
            return
        end

        local targetChar = hoverTarget.Character
        local targetHead = targetChar:FindFirstChild("Head")
            or targetChar:FindFirstChild("UpperTorso")
            or targetChar:FindFirstChild("Torso")
            or targetChar:FindFirstChild("HumanoidRootPart")

        if not targetHead then
            stopHover()
            return
        end

        local currentChar = player.Character
        if not currentChar then
            stopHover()
            return
        end

        local currentHrp = currentChar:FindFirstChild("HumanoidRootPart")
        local currentHum = currentChar:FindFirstChild("Humanoid")
        if not currentHrp or not currentHum then
            stopHover()
            return
        end

        local hoverPos = targetHead.Position + Vector3.new(2, hoverRange, 0)
        local lookAt = Vector3.new(targetHead.Position.X, hoverPos.Y, targetHead.Position.Z)
        currentHrp.CFrame = CFrame.new(hoverPos, lookAt)
        currentHrp.AssemblyLinearVelocity = Vector3.zero
        currentHrp.AssemblyAngularVelocity = Vector3.zero

        currentHum.PlatformStand = true
        currentHum.AutoRotate = false
    end)

    return true
end

local function onHoverHPressed()
    if not hoverEnabled then return end

    if isHovering then
        stopHover()
    else
        local target = getPlayerLookingAt()
        if target then
            startHover(target)
        end
    end
end

