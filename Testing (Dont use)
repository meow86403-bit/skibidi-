-- ==================== NAME ESP LOGIC ====================
local nameESPEnabled = false
local nameLabels = {}

local function createNameLabel(plr)
    if plr == player then return end
    if nameLabels[plr] then return end

    local displayLine = Drawing.new("Text")
    displayLine.Visible = false
    displayLine.Color = Color3.fromRGB(255, 255, 255)
    displayLine.Size = 14
    displayLine.Center = true
    displayLine.Outline = true
    displayLine.OutlineColor = Color3.fromRGB(0, 0, 0)
    displayLine.Font = Drawing.Fonts.UI

    local userLine = Drawing.new("Text")
    userLine.Visible = false
    userLine.Color = Color3.fromRGB(180, 180, 180)
    userLine.Size = 12
    userLine.Center = true
    userLine.Outline = true
    userLine.OutlineColor = Color3.fromRGB(0, 0, 0)
    userLine.Font = Drawing.Fonts.UI

    nameLabels[plr] = {display = displayLine, user = userLine}
end

local function removeNameLabel(plr)
    if not nameLabels[plr] then return end
    pcall(function()
        nameLabels[plr].display:Remove()
        nameLabels[plr].user:Remove()
    end)
    nameLabels[plr] = nil
end

local function removeAllNameLabels()
    for plr, _ in pairs(nameLabels) do
        removeNameLabel(plr)
    end
end

local function updateNameLabel(plr)
    if not nameLabels[plr] then return end

    local character = plr.Character
    if not character then
        nameLabels[plr].display.Visible = false
        nameLabels[plr].user.Visible = false
        return
    end

    local head = character:FindFirstChild("Head")
    if not head then
        nameLabels[plr].display.Visible = false
        nameLabels[plr].user.Visible = false
        return
    end

    local aboveHead = head.Position + Vector3.new(0, 3.5, 0)
    local screenPos, onScreen = Camera:WorldToViewportPoint(aboveHead)

    if not onScreen then
        nameLabels[plr].display.Visible = false
        nameLabels[plr].user.Visible = false
        return
    end

    local pos = Vector2.new(screenPos.X, screenPos.Y)

    nameLabels[plr].display.Text = plr.DisplayName
    nameLabels[plr].display.Position = pos
    nameLabels[plr].display.Visible = true

    nameLabels[plr].user.Text = "@" .. plr.Name
    nameLabels[plr].user.Position = Vector2.new(pos.X, pos.Y + 16)
    nameLabels[plr].user.Visible = true
end

