-- ==================== SKELETON ESP LOGIC ====================
local skeletonEnabled = false
local skeletonLines = {}

local function getJoints(character)
    local function pos(partName)
        local part = character:FindFirstChild(partName)
        return part and part.Position or nil
    end

    local head = pos("Head")
    local torso = pos("UpperTorso") or pos("Torso")
    local lowerTorso = pos("LowerTorso") or pos("Torso")
    local lShoulder = pos("LeftUpperArm") or pos("Left Arm")
    local rShoulder = pos("RightUpperArm") or pos("Right Arm")
    local lElbow = pos("LeftLowerArm") or pos("Left Arm")
    local rElbow = pos("RightLowerArm") or pos("Right Arm")
    local lHand = pos("LeftHand") or pos("Left Arm")
    local rHand = pos("RightHand") or pos("Right Arm")
    local lHip = pos("LeftUpperLeg") or pos("Left Leg")
    local rHip = pos("RightUpperLeg") or pos("Right Leg")
    local lKnee = pos("LeftLowerLeg") or pos("Left Leg")
    local rKnee = pos("RightLowerLeg") or pos("Right Leg")
    local lFoot = pos("LeftFoot") or pos("Left Leg")
    local rFoot = pos("RightFoot") or pos("Right Leg")

    local isR6 = character:FindFirstChild("Torso") ~= nil and character:FindFirstChild("UpperTorso") == nil

    if isR6 then
        local torsoPart = character:FindFirstChild("Torso")
        local lArmPart = character:FindFirstChild("Left Arm")
        local rArmPart = character:FindFirstChild("Right Arm")
        local lLegPart = character:FindFirstChild("Left Leg")
        local rLegPart = character:FindFirstChild("Right Leg")

        if torsoPart then
            torso = torsoPart.Position + Vector3.new(0, 0.5, 0)
            lowerTorso = torsoPart.Position - Vector3.new(0, 0.8, 0)
        end
        if lArmPart then
            lShoulder = lArmPart.Position + Vector3.new(0, 0.8, 0)
            lElbow = lArmPart.Position
            lHand = lArmPart.Position - Vector3.new(0, 0.8, 0)
        end
        if rArmPart then
            rShoulder = rArmPart.Position + Vector3.new(0, 0.8, 0)
            rElbow = rArmPart.Position
            rHand = rArmPart.Position - Vector3.new(0, 0.8, 0)
        end
        if lLegPart then
            lHip = lLegPart.Position + Vector3.new(0, 0.8, 0)
            lKnee = lLegPart.Position
            lFoot = lLegPart.Position - Vector3.new(0, 0.8, 0)
        end
        if rLegPart then
            rHip = rLegPart.Position + Vector3.new(0, 0.8, 0)
            rKnee = rLegPart.Position
            rFoot = rLegPart.Position - Vector3.new(0, 0.8, 0)
        end
    end

    return {
        {head, torso},
        {torso, lowerTorso},
        {torso, lShoulder},
        {lShoulder, lElbow},
        {lElbow, lHand},
        {torso, rShoulder},
        {rShoulder, rElbow},
        {rElbow, rHand},
        {lowerTorso, lHip},
        {lHip, lKnee},
        {lKnee, lFoot},
        {lowerTorso, rHip},
        {rHip, rKnee},
        {rKnee, rFoot},
    }
end

local function createSkeletonForPlayer(plr)
    if plr == player then return end
    if skeletonLines[plr] then return end

    skeletonLines[plr] = {}
    for i = 1, 14 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = Color3.fromRGB(255, 255, 255)
        line.Thickness = 1.5
        line.Transparency = 1
        table.insert(skeletonLines[plr], line)
    end
end

local function removeSkeletonForPlayer(plr)
    if not skeletonLines[plr] then return end
    for _, line in ipairs(skeletonLines[plr]) do
        line:Remove()
    end
    skeletonLines[plr] = nil
end

local function removeAllSkeletons()
    for plr, _ in pairs(skeletonLines) do
        removeSkeletonForPlayer(plr)
    end
end

local function updateSkeletonForPlayer(plr)
    if not skeletonLines[plr] then return end

    local character = plr.Character
    if not character then
        for _, line in ipairs(skeletonLines[plr]) do
            line.Visible = false
        end
        return
    end

    local joints = getJoints(character)

    for i, line in ipairs(skeletonLines[plr]) do
        local joint = joints[i]
        if joint and joint[1] and joint[2] then
            local screenA, onA = Camera:WorldToViewportPoint(joint[1])
            local screenB, onB = Camera:WorldToViewportPoint(joint[2])
            if onA and onB then
                line.From = Vector2.new(screenA.X, screenA.Y)
                line.To = Vector2.new(screenB.X, screenB.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end

