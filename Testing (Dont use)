-- ==================== ESP LOGIC ====================
local ESPHighlights = {}
local espEnabled = false
local espType = "Outline"

local function applyESPStyle(highlight)
    if espType == "Outline" then
        highlight.FillTransparency = 1
        highlight.OutlineTransparency = 0
        highlight.FillColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    elseif espType == "Box" then
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 1
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    end
end

local function refreshAllESP()
    for _, h in pairs(ESPHighlights) do
        if h and h.Parent then
            applyESPStyle(h)
        end
    end
end

local function removeESP()
    for _, h in pairs(ESPHighlights) do
        pcall(function() h:Destroy() end)
    end
    ESPHighlights = {}
end

local function addESPToPlayer(plr)
    if plr == player then return end
    local function applyHighlight(character)
        for i, h in pairs(ESPHighlights) do
            if h and h.Parent and h.Adornee == character then
                pcall(function() h:Destroy() end)
                table.remove(ESPHighlights, i)
                break
            end
        end
        local highlight = Instance.new("Highlight")
        highlight.Adornee = character
        highlight.Parent = character
        applyESPStyle(highlight)
        table.insert(ESPHighlights, highlight)
    end

    if plr.Character then
        applyHighlight(plr.Character)
    end
    plr.CharacterAdded:Connect(function(char)
        if espEnabled then
            task.wait(0.5)
            applyHighlight(char)
        end
    end)
end

local function toggleESP(enabled)
    if not enabled then
        removeESP()
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        addESPToPlayer(plr)
    end
end

ESPCheckbox.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    ESPCheckbox.BackgroundColor3 = espEnabled and Color3.fromRGB(140, 60, 200) or Color3.fromRGB(40, 40, 45)
    toggleESP(espEnabled)
end)

Players.PlayerAdded:Connect(function(plr)
    if espEnabled then
        addESPToPlayer(plr)
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    if plr.Character then
        for i, h in pairs(ESPHighlights) do
            if h and h.Adornee == plr.Character then
                pcall(function() h:Destroy() end)
                table.remove(ESPHighlights, i)
                break
            end
        end
    end
end)

