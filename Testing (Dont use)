-- ==================== PLAYER LOOKING LOGIC ====================
local playerLookingEnabled = false
local lookingLabels = {}

-- Returns the name of the player that 'looker' is most likely looking at,
-- based on the look direction of their HumanoidRootPart / head.
-- Uses a dot-product approach: closest player within a forward cone wins.
local function getPlayerBeingLookedAt(looker)
    local char = looker.Character
    if not char then return nil end

    -- Prefer head look direction; fall back to HRP
    local head = char:FindFirstChild("Head")
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local origin    = head and head.Position or hrp.Position
    local lookDir   = (head and head.CFrame.LookVector) or hrp.CFrame.LookVector

    local bestTarget = nil
    local bestScore  = -math.huge  -- higher = more "in front" and closer

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= looker and target ~= player then
            local tChar = target.Character
            if tChar then
                local tHead = tChar:FindFirstChild("Head")
                local tHRP  = tChar:FindFirstChild("HumanoidRootPart")
                local tHum  = tChar:FindFirstChild("Humanoid")
                if tHRP and tHum and tHum.Health > 0 then
                    local targetPos = tHead and tHead.Position or tHRP.Position
                    local toTarget  = (targetPos - origin)
                    local dist      = toTarget.Magnitude
                    if dist < 200 and dist > 0 then
                        local dot = lookDir:Dot(toTarget.Unit)
                        -- Only count targets that are in the forward half-sphere
                        -- Weight: favour being directly in front AND being close
                        if dot > 0.6 then
                            local score = dot - (dist / 200)
                            if score > bestScore then
                                bestScore  = score
                                bestTarget = target
                            end
                        end
                    end
                end
            end
        end
    end

    return bestTarget
end

local function createLookingLabel(plr)
    if plr == player then return end
