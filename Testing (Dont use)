-- ==================== ATTACH FUNCTIONS ====================
local function getPlayerLookingAt()
    local camera = workspace.CurrentCamera
    local mouseLocation = UserInputService:GetMouseLocation()
    
    local closestPlayer = nil
    local closestDistance = math.huge
    
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local character = targetPlayer.Character
            if character then
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local mousePos = Vector2.new(mouseLocation.X, mouseLocation.Y)
                        local screenVector = Vector2.new(screenPos.X, screenPos.Y)
                        local distance = (screenVector - mousePos).Magnitude
                        
                        if distance < 150 and distance < closestDistance then
                            closestDistance = distance
                            closestPlayer = targetPlayer
                        end
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

local function saveOriginalPosition()
    local character = player.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            originalPosition = hrp.Position
            originalCFrame = hrp.CFrame
        end
    end
    originalCameraCFrame = Camera.CFrame
end

local function teleportToOriginalPosition()
    local character = player.Character
    if character and originalPosition then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = originalCFrame or CFrame.new(originalPosition)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        local hum = character:FindFirstChild("Humanoid")
        if hum then
            hum.AutoRotate = true
            hum.PlatformStand = false
        end
    end
    if originalCameraCFrame then
        Camera.CFrame = originalCameraCFrame
        Camera.CameraType = Enum.CameraType.Custom
    end
    originalPosition = nil
    originalCFrame = nil
    originalCameraCFrame = nil
end

local function detach()
    if attachConnection then
        attachConnection:Disconnect()
        attachConnection = nil
    end
    attachedTarget = nil
    isAttached = false
    targetLastPos = nil
    targetVelocity = Vector3.zero
    
    Camera.CameraType = Enum.CameraType.Custom
    teleportToOriginalPosition()
    
    local character = player.Character
    if character then
        local hum = character:FindFirstChild("Humanoid")
        if hum then
            hum.AutoRotate = true
            hum.PlatformStand = false
        end
    end
end

local function attachToTarget(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    
    saveOriginalPosition()
    
    local targetChar = targetPlayer.Character
    local targetTorso = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")
    
    if not targetTorso then
        local hrp = targetChar:FindFirstChild("HumanoidRootPart")
        if hrp then
            targetTorso = hrp
        else
            return false
        end
    end
    
    local character = player.Character
    if not character then return false end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChild("Humanoid")
    
    if not hrp or not hum then return false end
    
    attachedTarget = targetPlayer
    isAttached = true
    targetLastPos = targetTorso.Position
    targetVelocity = Vector3.zero
    
    hum.AutoRotate = false
    hum.PlatformStand = true
    
    attachConnection = RunService.Heartbeat:Connect(function()
        if not isAttached or not attachedTarget or not attachedTarget.Character then
            detach()
            return
        end
        
        local currentTarget = attachedTarget.Character
        local currentTargetTorso = currentTarget:FindFirstChild("UpperTorso") or currentTarget:FindFirstChild("Torso")
        
        if not currentTargetTorso then
            local currentHrp = currentTarget:FindFirstChild("HumanoidRootPart")
            if currentHrp then
                currentTargetTorso = currentHrp
            else
                detach()
                return
            end
        end
        
        local currentChar = player.Character
        if not currentChar then
            detach()
            return
        end
        
        local currentHrp = currentChar:FindFirstChild("HumanoidRootPart")
        local currentHum = currentChar:FindFirstChild("Humanoid")
        if not currentHrp or not currentHum then
            detach()
            return
        end
        
        local currentPos = currentTargetTorso.Position
        if targetLastPos then
            local dt = RunService.Heartbeat:Wait()
            local rawVel = (currentPos - targetLastPos) / (dt + 0.016)
            targetVelocity = targetVelocity:Lerp(rawVel, 0.3)
        end
        targetLastPos = currentPos
        
        local predictedPos = currentPos + (targetVelocity * PREDICTION_FACTOR)
        
        local torsoPos = predictedPos
        if currentTargetTorso.Name == "HumanoidRootPart" then
            torsoPos = torsoPos + Vector3.new(0, 1.5, 0)
        end
        
        currentHrp.CFrame = CFrame.new(torsoPos, torsoPos + Vector3.new(0, 1, 0))
        
        local flingPower = 1000
        local randomAngle = math.random(0, 360) * math.pi / 180
        local randomDirX = math.cos(randomAngle)
        local randomDirZ = math.sin(randomAngle)
        local horizontalDir = Vector3.new(randomDirX, 0, randomDirZ).Unit
        local launchVector = (horizontalDir * flingPower) + Vector3.new(0, flingPower * 0.8, 0)
        
        currentHrp.AssemblyLinearVelocity = launchVector
        currentHrp.AssemblyAngularVelocity = Vector3.zero
        
        currentHum.PlatformStand = true
        currentHum.AutoRotate = false
        
        local cameraOffset = Vector3.new(0, 3, 8)
        local targetCameraPos = currentHrp.Position + cameraOffset
        Camera.CameraType = Enum.CameraType.Scriptable
        Camera.CFrame = CFrame.new(targetCameraPos, currentHrp.Position + Vector3.new(0, 1, 0))
    end)
    
    return true
end

local function toggleAttachMode()
    attachModeEnabled = not attachModeEnabled
    AttachCheckbox.BackgroundColor3 = attachModeEnabled and Color3.fromRGB(140, 60, 200) or Color3.fromRGB(40, 40, 45)
    
    if not attachModeEnabled and isAttached then
        detach()
    end
end

local function onHPressed()
    if not attachModeEnabled then return end
    if hoverEnabled then return end
    
    if isAttached then
        detach()
    else
        local target = getPlayerLookingAt()
        if target then
            attachToTarget(target)
        end
    end
end

