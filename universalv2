-- Aimbot Functions
local fovActive = false
local fovRad = 50
local fovCircle = nil
local locking = false
local currentTarget = nil

local function createFOV()
    if fovCircle then fovCircle:Destroy() end
    fovCircle = Instance.new("Frame")
    fovCircle.Size = UDim2.new(0, fovRad * 2, 0, fovRad * 2)
    fovCircle.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
    fovCircle.BackgroundTransparency = 0.8
    fovCircle.BorderSizePixel = 2
    fovCircle.BorderColor3 = Color3.fromRGB(0, 150, 200)
    fovCircle.Visible = fovActive
    fovCircle.Parent = gui
end

local function updateFOV()
    if fovCircle then
        local mouse = LocalPlayer:GetMouse()
        fovCircle.Position = UDim2.new(0, mouse.X - fovRad, 0, mouse.Y - fovRad)
    end
end

local function getClosest()
    local mouse = LocalPlayer:GetMouse()
    local closest = nil
    local closestDist = fovRad
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos, on = workspace.CurrentCamera:WorldToScreenPoint(hrp.Position)
                if on then
                    local dist = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(pos.X, pos.Y)).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

fovToggle.btn.MouseButton1Click:Connect(function()
    fovActive = not fovActive
    if fovActive then
        createFOV()
        fovToggle.circle.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        fovToggle.circle.Position = UDim2.new(0, 11, 0.5, -13)
