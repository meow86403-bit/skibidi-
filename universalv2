    ind.Parent = frame
    
    local indC = Instance.new("UICorner")
    indC.CornerRadius = UDim.new(1, 0)
    indC.Parent = ind
    
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 26, 0, 26)
    circle.Position = UDim2.new(0, 3, 0.5, -13)
    circle.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
